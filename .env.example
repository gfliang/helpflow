# Infrastructure (used by Docker Compose and the API)
POSTGRES_DB=helpflow
POSTGRES_USER=helpflow
POSTGRES_PASSWORD=helpflow_dev_password
# 5433 avoids colliding with a PostgreSQL server already installed on the host.
DATABASE_URL=postgresql+psycopg://helpflow:helpflow_dev_password@localhost:5433/helpflow
REDIS_URL=redis://localhost:6379/0

# Application
APP_ENV=development
APP_NAME=HelpFlow API
API_V1_PREFIX=/api/v1
FRONTEND_ORIGINS=http://localhost:5173
JWT_SECRET=change-this-before-any-non-local-use
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# AI chat. Configure at least one real LLM below — either an OpenAI-compatible
# endpoint (LLM_API_KEY + LLM_BASE_URL) or OpenRouter (OPENROUTER_API_KEY).
# LLM_PROVIDER accepts: auto | openrouter | openai.
LLM_PROVIDER=auto
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
CHAT_CONFIDENCE_THRESHOLD=0.16

# OpenRouter: configure this if you prefer a managed provider.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Rate limiting. Falls back to an in-process window when Redis is unreachable.
RATE_LIMIT_ENABLED=true
PUBLIC_CHAT_LIMIT_PER_MINUTE=30
LOGIN_LIMIT_PER_MINUTE=12

# Retrieval. BGE runs locally through fastembed (no API key). Set EMBEDDING_BACKEND=hash
# for fully offline tests or machines without the model cache.
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSIONS=512
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_DIR=
RAG_MULTI_QUERY_ENABLED=true
RAG_MULTI_QUERY_COUNT=3
RAG_CANDIDATE_LIMIT=24

# LangGraph agent + human-in-the-loop approval for refunds.
AGENT_ENABLED=true
AGENT_USE_LLM=true
AGENT_MAX_STEPS=4
# postgres persists graph state across restarts; memory keeps it in-process.
AGENT_CHECKPOINT_BACKEND=postgres

# Observability (optional). Start the stack with `make infra-obs`, then fill in the keys.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3030

# Evaluation. Set to true to use an LLM judge instead of the offline heuristic.
EVAL_JUDGE_ENABLED=false

